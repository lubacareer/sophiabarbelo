# Choose xai (default), groq, or openai. Keep API keys private.
ANALYSIS_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional: grok-4.7 reasoning effort (low, medium, high, or xhigh).
# XAI_REASONING_EFFORT=low

# Optional: configure these when ANALYSIS_PROVIDER=groq.
GROQ_API_KEY=
# Choose a Groq model that supports browser search and structured outputs.
GROQ_MODEL=openai/gpt-oss-120b

# Optional local OpenAI provider: web search and model requests consume API credits.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Deployed Gemini/Cloudflare research uses Tavily; never use VITE_ prefixes.
GEMINI_API_KEY=
TAVILY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Caddy deployment. Keep the hash and proxy secret private.
# Use the same .env for Caddy and the Node server; see README for setup.
SOPHIA_DOMAIN=localhost
SOPHIA_ADMIN_USER=admin
SOPHIA_ADMIN_HASH=
SOPHIA_PROXY_SECRET=
# ALLOWED_HOSTS=example.com

# Vercel: keep sophiabarbelo public and create sophiabarbelo-admin separately.
# Configure server-side variables in each project; do not import this local file.
# Both deployed roles offer the same four models and default to Luna.
# Never add administrator passwords or proxy credentials to the public project.
# SOPHIA_DEPLOYMENT_ROLE=public
# Luna needs OPENAI_API_KEY and explicit cost confirmation in each project.
# SOPHIA_OPENAI_COSTS_CONFIRMED=true
# Public only: XAI_API_KEY permits public Grok calls after this cost opt-in.
# SOPHIA_PUBLIC_XAI_COSTS_CONFIRMED=true
# Enable free paths only after verifying each provider's account/billing state.
# Gemini: unbilled Free Tier project; Cloudflare: Workers Free;
# Tavily: Researcher plan with PAYGO off. These are shared, limited allowances.
# SOPHIA_GEMINI_FREE_CONFIRMED=true
# Alternatively, enable Gemini API-credit billing after explicit cost approval.
# For billed projects keep SOPHIA_GEMINI_FREE_CONFIRMED=false.
# Eligible Cloud credits are used first, then paid funds under Google's billing plan.
# SOPHIA_GEMINI_COSTS_CONFIRMED=true
# SOPHIA_CLOUDFLARE_FREE_CONFIRMED=true
# SOPHIA_TAVILY_FREE_CONFIRMED=true
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Administrator project: protect All Deployments before adding XAI_API_KEY.
# SOPHIA_DEPLOYMENT_ROLE=admin
# SOPHIA_ADMIN_PROTECTION_CONFIRMED=true
# Deployed Groq routes/fallbacks and SOPHIA_PUBLIC_PROVIDER are no longer used.
# Local ANALYSIS_PROVIDER=groq remains available for legacy compatibility.
